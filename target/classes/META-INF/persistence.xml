<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="dtqt05PU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Danh sách các Entity ánh xạ JPA -->
        <class>vn.edu.hcmute.model.UserRole</class>
        <class>vn.edu.hcmute.model.Seller</class>
        <class>vn.edu.hcmute.model.User</class>
        <class>vn.edu.hcmute.model.Category</class>
        <class>vn.edu.hcmute.model.Product</class>
        <class>vn.edu.hcmute.model.Cart</class>
        <class>vn.edu.hcmute.model.CartItem</class>

        <properties>
            <!-- Thông số kết nối MySQL -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/dtqt05?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;characterEncoding=UTF-8" />
            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="Khangcv@1" />

            <!-- Cấu hình Hibernate 6 -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- Mã hóa ký tự UTF-8 tiếng Việt -->
            <property name="hibernate.connection.characterEncoding" value="utf8" />
            <property name="hibernate.connection.useUnicode" value="true" />
        </properties>
    </persistence-unit>
</persistence>
